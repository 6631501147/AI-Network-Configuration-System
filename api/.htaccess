# ================================================================
#  api/.htaccess — CORS headers for all PHP API endpoints
#  Required so Apache sends Access-Control-Allow-Origin before
#  PHP executes (covers preflight OPTIONS requests too).
# ================================================================

# Enable mod_headers (already on by default in XAMPP)
<IfModule mod_headers.c>
    # Allow the Python dev server on port 8000 AND direct XAMPP access
    SetEnvIf Origin "^http://(localhost|127\.0\.0\.1)(:[0-9]+)?$" CORS_ALLOWED=1

    Header always set Access-Control-Allow-Origin "http://localhost:8000" env=CORS_ALLOWED
    Header always set Access-Control-Allow-Credentials "true"
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Accept"
    Header always set Access-Control-Max-Age "86400"
</IfModule>

# Handle OPTIONS preflight without executing PHP
RewriteEngine On
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=204,L]
